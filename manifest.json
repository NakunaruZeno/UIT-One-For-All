{
  "manifest_version": 3,
  "name": "UIT One For All",
  "version": "1.3.1",
  "description": "Auto Login, Cào Điểm, Lịch Thi, TKB ICS, Cảnh báo Lịch học & Auto Survey",
  "icons": {
    "16": "icon/Icon16.png",
    "24": "icon/Icon24.png",
    "32": "icon/Icon32.png",
    "64": "icon/Icon64.png",
    "128": "icon/Icon128.png"
  },
  "author": "NakunaruZeno",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cài đặt UIT Extension",
    "default_icon": "icon/Icon64.png"
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "*://student.uit.edu.vn/*",
    "*://courses.uit.edu.vn/*",
    "*://daa.uit.edu.vn/*",
    "*://survey.uit.edu.vn/*",
    "*://oep.uit.edu.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://student.uit.edu.vn/*",
        "*://courses.uit.edu.vn/*",
        "*://daa.uit.edu.vn/*",
        "*://survey.uit.edu.vn/*",
        "*://oep.uit.edu.vn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}