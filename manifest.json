{
  "manifest_version": 3,
  "name": "UIT One For All",
  "version": "1.3",
  "description": "Auto Login, Cào Điểm, Lịch Thi, TKB ICS, Cảnh báo Lịch học & Auto Survey",
  "author": "NakunaruZeno",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cài đặt UIT Extension"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "*://student.uit.edu.vn/*",
    "*://courses.uit.edu.vn/*",
    "*://daa.uit.edu.vn/*",
    "*://survey.uit.edu.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://student.uit.edu.vn/*",
        "*://courses.uit.edu.vn/*",
        "*://daa.uit.edu.vn/*",
        "*://survey.uit.edu.vn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}